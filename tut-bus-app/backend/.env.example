# PostgreSQL connection (docker-compose default)
DATABASE_URL="postgresql://tutbus:tutbus_password@localhost:5432/tutbus?schema=public"

# Server
PORT=3000
NODE_ENV=development

# When "true" (default), student registration signs the student straight in
# with no OTP email-verification step. Set to "false" for production.
SKIP_EMAIL_VERIFICATION=true

# JWT
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me_too_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS - comma separated origins allowed to call the API
CORS_ORIGINS="http://localhost:3001,http://localhost:19006"

# Firebase Cloud Messaging (optional - push notifications)
# Paste the JSON contents of your Firebase service account key here (single line)
FCM_SERVICE_ACCOUNT_JSON=""

# Google Maps (used by mobile/web clients, referenced here for completeness)
GOOGLE_MAPS_API_KEY=""
