  "description": "TUT Bus App - Backend API (NestJS + Prisma + PostgreSQL)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
